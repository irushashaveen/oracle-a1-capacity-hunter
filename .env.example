# Required by docker-compose.yml. Point this at the directory containing your
# OCI config file and API signing key. Do not commit a populated .env file.
OCI_CONFIG_DIR=/absolute/path/to/clone/secrets/oci
HOST_PORT=18080

# Optional notification channels. Values here are local secrets and are ignored
# by Git. Leave channels disabled until credentials are configured.
OCI_A1__NOTIFICATIONS__TELEGRAM__ENABLED=false
OCI_A1__NOTIFICATIONS__TELEGRAM__BOT_TOKEN=
OCI_A1__NOTIFICATIONS__TELEGRAM__CHAT_ID=
OCI_A1__NOTIFICATIONS__DISCORD__ENABLED=false
OCI_A1__NOTIFICATIONS__DISCORD__WEBHOOK_URL=
OCI_A1__NOTIFICATIONS__WEBHOOK__ENABLED=false
OCI_A1__NOTIFICATIONS__WEBHOOK__URL=
